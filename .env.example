# Copy this file to .env and fill in your real values for local testing.
# NEVER commit the real .env file -- only this example file belongs in git.
# In production (GitHub Actions), these are set as repository secrets instead
# of a .env file -- see README.md for how.

# Telegram bot token from @BotFather, looks like: 123456789:AAExampleTokenHere
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# The channel the bot posts to. Can be a public channel username (starting
# with @) or a numeric chat id for a private channel, e.g. -1001234567890
TELEGRAM_CHANNEL_ID=@your_channel_username_or_numeric_id

# API key from https://www.football-data.org/ (free tier is enough)
FOOTBALL_DATA_API_KEY=your-football-data-api-key-here

# football-data.org's numeric id for RC Celta de Vigo. 558 is our best-guess
# default -- please verify it yourself (see README.md) before relying on it.
CELTA_TEAM_ID=558
